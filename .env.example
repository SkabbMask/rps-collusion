# Machine-specific Ollama endpoints. Copy to .env and edit (.env is gitignored).
# Experiment settings (models, rounds, collusion probability, prompts...) live in config.json.
# A URL may be ip:port (/api/chat is appended) or a full http://ip:port/path.
OLLAMA_URL=192.168.1.50:11434

# Optional: put individual players on different machines.
# PLAYER_A_URL=192.168.1.51:11434
# PLAYER_C_URL=http://192.168.1.52:11434/api/chat
